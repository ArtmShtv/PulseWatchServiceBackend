# Copy to .env and fill in the empty values.
# Hosts are for running code on your machine; docker-compose overrides them
# with the service names (postgres, redis) inside containers.

SECRET_KEY=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_NAME=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SENDER_EMAIL=
EMAIL_PASSWORD=

CORS_ORIGINS=http://localhost:5173

# Optional (defaults shown)
# ALLOW_PRIVATE_TARGETS=false
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SECONDS=60
